{
  "name": "@obsidian/interface",
  "version": "1.6.1",
  "description": "Obsidian Interface — self-hostable, light, mobile-first web interface for the Obsidian Network (wallet, miner, explorer, ONS, node runners, audit).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:web && npm run build:sites && tsc -p tsconfig.json",
    "build:core": "npm --prefix ../obsidian-core run build && node scripts/sync-core.mjs",
    "build:web": "node scripts/build-web.mjs && node scripts/check-browser-safe.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/server/main.js",
    "test": "vitest run --passWithNoTests",
    "check:browser-safe": "node scripts/check-browser-safe.mjs",
    "build:sites": "node scripts/build-sites.mjs",
    "verify": "npm run typecheck && npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "esbuild": "0.25.12",
    "jsdom": "^25.0.1",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "main": "dist/server/index.js",
  "bin": {
    "obsidian-interface": "dist/server/main.js"
  },
  "dependencies": {
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0",
    "@scure/bip32": "1.5.0",
    "@scure/bip39": "1.4.0"
  }
}
