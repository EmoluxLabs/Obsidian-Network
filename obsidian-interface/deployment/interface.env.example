# /etc/obsidian/<network>/interface.env — settings for ONE network's interface.
#
# One file per network, never a shared one: /etc/obsidian/testnet/interface.env,
# /etc/obsidian/devnet/interface.env, … It is read by the template unit
# obsidian-interface@<network>.service, where the text after the @ IS the network.
# The unit passes --network and --data-dir itself, so for the template you set
# neither OBSIDIAN_INTERFACE_NETWORK nor OBSIDIAN_INTERFACE_DATA_DIR here. If you
# do set the network and it names a different one than the instance, the interface
# refuses to start (it will not guess which chain you meant).
#
# If you run the plain obsidian-interface.service instead (one network on the
# machine), it passes neither flag, so uncomment those two lines below.
#
# An environment file has no trailing comments: keep every comment on its own line,
# because text after a value becomes part of the value.

# Which network does this interface serve? REQUIRED — there is no default. The
# interface refuses to read from a node that follows another network (so a devnet
# page can never show mainnet data), and unless you set a port below it uses this
# network's own:  mainnet 8788   testnet 18788   staging 28788   devnet 38788
# Plain obsidian-interface.service only.
#OBSIDIAN_INTERFACE_NETWORK=devnet

# Which Obsidian Core nodes may this interface read? Leave it out to read the
# network's default local node (devnet http://127.0.0.1:38630). To list more than
# one so a single node restart cannot take the window down, give each node's RPC
# URL on THIS network, comma separated, and prefer nodes you run yourself: an
# interface can only be as honest as the nodes it reads.
#OBSIDIAN_NODE_URLS=http://127.0.0.1:38630,http://node2.example:38630

OBSIDIAN_INTERFACE_HOST=127.0.0.1
#OBSIDIAN_INTERFACE_PORT=38788
# Plain obsidian-interface.service only: where accounts, sessions and the redeemed
# invitation are kept.
#OBSIDIAN_INTERFACE_DATA_DIR=/var/lib/obsidian-interface

# Sign-in is invite-only and entirely first-party: a Gmail address, a password,
# an invite code, then TOTP multi-factor. There is no OAuth client id to set and
# no email is ever sent. Account creation stays disabled until the Genesis
# Invitation hash is configured; the wallet, miner, explorer and every other page
# keep working without any account at all. Mint one (it prints the code ONCE and
# the hash to put here):
#   node /opt/obsidian/new-genesis-invite.mjs
# Never reuse an invitation on another network.
OBSIDIAN_GENESIS_INVITE_HASH=

# Set to true only when a reverse proxy you control terminates TLS in front. It
# makes the interface rate-limit by the LAST X-Forwarded-For entry (the address
# your proxy appended; anything earlier is client-supplied), mark the session
# cookie Secure, and trust X-Forwarded-Host/-Proto. Behind nginx, set this.
OBSIDIAN_INTERFACE_TRUST_PROXY=false

# Extra browser origins allowed to call the API with cookies: exact origins, or a
# whole-subdomain pattern such as https://*.example.org. Empty = same origin only,
# which is right when the interface serves its own pages. Listing an origin says
# every page it serves is as trusted as this interface's own.
#OBSIDIAN_INTERFACE_ALLOWED_ORIGINS=https://other.example

# Pages on obsmainnet.us.ci and its subdomains may READ the chain through this
# interface (and relay a signed transaction), never with cookies. Set false to turn
# that off; accounts and sessions stay same-origin either way.
#OBSIDIAN_INTERFACE_TRUST_OFFICIAL_DOMAINS=true

OBSIDIAN_INTERFACE_LOG_LEVEL=info

# Mining gate (protocol 1.7.0): the encrypted issuer keystore and its passphrase (12+ characters).
# Its public key must be listed on every node as OBSIDIAN_MINING_GATE_PUBLIC_KEYS. Without it nobody can mine.
#OBSIDIAN_GATE_KEYSTORE=/etc/obsidian/gate.keystore.json
#OBSIDIAN_GATE_KEYSTORE_PASSPHRASE_FILE=/etc/obsidian/gate.pass
