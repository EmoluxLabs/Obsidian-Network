# /etc/obsidian/interface.env — configuration for a self-hosted interface.
#
# Which Obsidian Core nodes may this interface read? List two or more so a
# single node restart cannot take the window down, and prefer nodes you run
# yourself: an interface can only be as honest as the nodes it reads.
OBSIDIAN_NODE_URLS=http://127.0.0.1:8630,http://node2.example:8630

OBSIDIAN_INTERFACE_HOST=127.0.0.1
OBSIDIAN_INTERFACE_PORT=8788
OBSIDIAN_INTERFACE_DATA_DIR=/var/lib/obsidian-interface

# Invite-only sign-in. Leave the client id empty to disable account creation
# entirely: the wallet, miner, explorer and every other page keep working.
OBSIDIAN_GOOGLE_CLIENT_ID=

# Set to true only when a reverse proxy you control terminates TLS in front.
OBSIDIAN_INTERFACE_TRUST_PROXY=false

OBSIDIAN_INTERFACE_LOG_LEVEL=info
