{
  "manifest_version": 3,
  "name": "Obsidian Network",
  "version": "1.0.0",
  "description": "Mine OBS, claim every 4 hours, manage your wallet and read the chain \u2014 against a real Obsidian node, from your browser.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Obsidian Network",
    "default_popup": "popup.html?popup=1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "obsidian-extension@obsmainnet.us.ci",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
