{
  "about": "Mining Pool view vectors. Read by obsidian-core (describeMiningPool in src/protocol/display.ts), obsidian-interface and obsidian-app-web (data.mjs mirror). The pool is `GET /supply` poolBalanceObs; a missing, malformed or wrong-chain answer is never shown as zero. Keys left out of `expect` are not checked.",
  "cases": [
    {"name": "a nonzero pool is shown", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": "0.000040000000000000", "invariantOk": true}}, "expect": {"state": "ok", "value": "0.00004 OBS", "zero": false, "exact": "0.00004 OBS"}},
    {"name": "a genuine zero is shown as zero, and flagged as a real zero", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": "0.000000000000000000", "invariantOk": true}}, "expect": {"state": "ok", "value": "0 OBS", "zero": true}},
    {"name": "the 6-decimal policy applies to the pool", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": "99999.820626666666666664", "invariantOk": true}}, "expect": {"state": "ok", "value": "99,999.820627 OBS", "exact": "99,999.820626666666666664 OBS", "zero": false}},
    {"name": "a pool below the shown precision is not zero", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": "0.000000000000000001", "invariantOk": true}}, "expect": {"state": "ok", "value": "<0.000001 OBS", "zero": false, "exact": "0.000000000000000001 OBS"}},
    {"name": "lifetime inflow and outflow come from /status when the node returns them", "input": {"expectedChainId": 7777, "status": {"chainId": 7777, "pool": {"lifetimeInflow": "0.000040000000000000", "lifetimeDistributed": "0.000040000000000000"}}, "supply": {"poolBalanceObs": "0.000000000000000000"}}, "expect": {"state": "ok", "value": "0 OBS", "zero": true, "lifetimeInflow": "0.00004 OBS", "lifetimeDistributed": "0.00004 OBS"}},
    {"name": "a missing /supply answer is unavailable, never zero", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": null}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "no answer at all is unavailable", "input": {"expectedChainId": 7777}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "a /supply answer without the pool field is unavailable (nothing is inferred from supply or mined)", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"totalSupplyObs": "100000.000626666666666664", "minedSupplyObs": "0.000626666666666664", "genesisIssuedObs": "100000.000000000000000000", "invariantOk": true}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "a null pool field is unavailable", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": null}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "an empty pool field is unavailable", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": ""}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "a malformed pool field is unavailable", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": "abc"}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "scientific notation is not a pool balance", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": "1e-18"}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "a JavaScript number is not a pool balance", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": 0}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "a bare integer without a decimal point is not the node's decimal form", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": "0"}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "a node on another chain is a mismatch and shows nothing", "input": {"expectedChainId": 7777, "status": {"chainId": 7778}, "supply": {"poolBalanceObs": "5.000000000000000000", "invariantOk": true}}, "expect": {"state": "mismatch", "value": "—", "zero": false}},
    {"name": "a devnet node behind a mainnet interface is a mismatch", "input": {"expectedChainId": 7777, "status": {"chainId": 7780}, "supply": {"poolBalanceObs": "0.000000000000000000"}}, "expect": {"state": "mismatch", "value": "—", "zero": false}},
    {"name": "an unreported chain, when one is expected, is unavailable rather than trusted", "input": {"expectedChainId": 7777, "status": {}, "supply": {"poolBalanceObs": "5.000000000000000000"}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "a missing /status, when a chain is expected, is unavailable rather than trusted", "input": {"expectedChainId": 7777, "supply": {"poolBalanceObs": "5.000000000000000000"}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "the chain id may arrive as text", "input": {"expectedChainId": 7777, "status": {"chainId": "7777"}, "supply": {"poolBalanceObs": "2.000000000000000000"}}, "expect": {"state": "ok", "value": "2 OBS", "zero": false}},
    {"name": "with no expected chain the network check is skipped", "input": {"supply": {"poolBalanceObs": "2.000000000000000000"}}, "expect": {"state": "ok", "value": "2 OBS", "zero": false}},
    {"name": "a failed supply invariant withholds the figure", "input": {"expectedChainId": 7777, "status": {"chainId": 7777}, "supply": {"poolBalanceObs": "2.000000000000000000", "invariantOk": false}}, "expect": {"state": "unavailable", "value": "—", "zero": false}},
    {"name": "malformed lifetime fields are left out, not guessed", "input": {"expectedChainId": 7777, "status": {"chainId": 7777, "pool": {"lifetimeInflow": "zzz", "lifetimeDistributed": null}}, "supply": {"poolBalanceObs": "1.000000000000000000"}}, "expect": {"state": "ok", "value": "1 OBS", "zero": false, "lifetimeInflow": null, "lifetimeDistributed": null}}
  ]
}
