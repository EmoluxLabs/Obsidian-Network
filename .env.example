# ─────────────────────────────────────────────────────────────────────────────
# Obsidian Network — example environment for the whole stack.
#
# Copy this file, fill in your own values, and keep it out of version control
# (`.env` is ignored). Nothing here is a default you should keep.
#
# Two processes make a deployment:
#
#   obsidian-core       the node: consensus, chain, RPC, indexer   (a source of truth)
#   obsidian-interface  the reader: wallet, miner, explorer, apps  (a cache)
#
# The interface can be replaced, restarted or switched off without touching the
# chain. The node cannot: it is what the chain is.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node (obsidian-core) ─────────────────────────────────────────────────────
# mainnet | testnet | staging | devnet. Never point a node at a data directory
# written by a different network; it will refuse to start, on purpose.
OBSIDIAN_NETWORK=mainnet
OBSIDIAN_NODE_NAME=node1
OBSIDIAN_DATA_DIR=/var/lib/obsidian-node

# The node identity keystore (scrypt + AES-256-GCM). Prefer the FILE variant:
# a passphrase in a shell variable ends up in shell history and process lists.
#   sudo install -m 0600 /dev/null /etc/obsidian/keystore.pass
#   sudo sh -c 'printf %s "your-long-passphrase" > /etc/obsidian/keystore.pass'
OBSIDIAN_KEYSTORE=/var/lib/obsidian-node/node-key.json
OBSIDIAN_KEYSTORE_PASSPHRASE_FILE=/etc/obsidian/keystore.pass

# Bootstrap peers: any node already on the network will do; the rest are
# discovered. Seeds that are down at boot are retried with exponential back-off.
OBSIDIAN_SEEDS=seed1.obsidian.example:8631,seed2.obsidian.example:8631

# Mining. A node that does not mine still validates and serves reads.
OBSIDIAN_MINE=true

# Keep RPC on loopback and publish an interface (or a proxy) instead. Never put
# a CDN in front of p2p.
OBSIDIAN_RPC_HOST=127.0.0.1
OBSIDIAN_P2P_HOST=0.0.0.0
OBSIDIAN_LOG_LEVEL=info

# ── Interface (obsidian-interface) ───────────────────────────────────────────
# List two or more nodes, preferably ones you run: an interface is only as
# honest as the nodes it reads from.
OBSIDIAN_NODE_URLS=http://127.0.0.1:8630,http://node2.example:8630

OBSIDIAN_INTERFACE_HOST=127.0.0.1
OBSIDIAN_INTERFACE_PORT=8788
OBSIDIAN_INTERFACE_DATA_DIR=/var/lib/obsidian-interface

# Accounts are first-party: a Gmail address, a password, an invite code and
# then TOTP multi-factor, all verified by this process. There is no OAuth
# client id to configure, no email is ever sent, and nothing is phoned home.
# Registration is still gated by the Genesis Invitation below, so an interface
# with no invitation configured simply cannot create its first account.

# The single-use Genesis Invitation that bootstraps the FIRST account on this
# interface deployment. Set the scrypt HASH here, never the code itself.
# Generate a fresh pair with:
#     node scripts/new-genesis-invite.mjs
# It prints the plaintext code once (write it down offline) and the hash to put
# here. Losing the code is unrecoverable by design: only the hash is stored, and
# nothing can turn it back into the code. A redeemed invitation stays redeemed
# even if you restart with a new hash.
OBSIDIAN_GENESIS_INVITE_HASH=

# Origins allowed to call the interface API (comma separated). Empty means
# same-origin only.
OBSIDIAN_INTERFACE_ALLOWED_ORIGINS=

# Set to true only when a reverse proxy YOU control terminates TLS in front.
OBSIDIAN_INTERFACE_TRUST_PROXY=false
OBSIDIAN_INTERFACE_LOG_LEVEL=info

# Per-package examples with more detail:
#   obsidian-core/deployment/node.env.example
#   obsidian-interface/deployment/interface.env.example
