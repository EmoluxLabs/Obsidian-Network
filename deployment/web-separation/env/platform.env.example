# Main platform: /etc/obsidian/mainnet/interface.env  (the file obsidian-interface@mainnet already reads).
# This is the ONLY change the platform needs to move from 8788 to 8789; add or edit these lines, keep the rest
# of the file (genesis invite hash, gate keystore, node URLs, ...) exactly as it is.
OBSIDIAN_INTERFACE_HOST=127.0.0.1
OBSIDIAN_INTERFACE_PORT=8789
# Behind nginx: rate-limit by the visitor address nginx appended, and mark the session cookie Secure.
OBSIDIAN_INTERFACE_TRUST_PROXY=true
