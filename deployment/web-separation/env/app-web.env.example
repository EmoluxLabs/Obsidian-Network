# Web App: /etc/obsidian/mainnet/app-web.env
APP_HOST=127.0.0.1
APP_PORT=8790
# The platform THIS app fronts, by its internal address (the platform's OBSIDIAN_INTERFACE_PORT).
OBSIDIAN_PLATFORM_URL=http://127.0.0.1:8789
APP_TRUST_PROXY=true
# Only if another site (not this host) must call this app's state-changing API from a browser; exact origins.
# APP_ALLOWED_ORIGINS=
