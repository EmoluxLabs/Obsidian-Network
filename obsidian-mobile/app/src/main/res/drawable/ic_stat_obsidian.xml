<?xml version="1.0" encoding="utf-8"?>
<!--
  The Edge Node's status-bar icon: the OBSIDIAN mark, as a monochrome vector.

  Notification icons are tinted by the system to a single colour, so a bitmap of
  the full logo would render as an unreadable blob — and the stock download glyph
  this replaces told the user nothing about which app was running. Drawn from the
  same geometry as the launcher mark so the branding is consistent.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.6 L21.2,7 L21.2,17 L12,22.4 L2.8,17 L2.8,7 Z M12,4.4 L5.4,8.3 L5.4,15.7 L12,19.6 L18.6,15.7 L18.6,8.3 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,7.6 L16,12 L12,16.4 L8,12 Z" />
</vector>
