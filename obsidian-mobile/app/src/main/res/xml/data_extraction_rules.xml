<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves this device in a cloud backup. The wallet keystore in
     particular must never be copied into a backup an attacker could pull from a
     Google account. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
