<?xml version="1.0" encoding="utf-8"?>
<!--
  Obsidian nodes are self-hosted: the network has no company-operated public
  endpoint, so the address a user enters is whatever they run — very often a
  plain http:// address on a LAN or a VPS. Android blocks cleartext by default
  from API 28, which without this file meant the app could not reach ANY node
  over http and every screen sat permanently offline.

  Cleartext is therefore permitted, and that trade-off is stated rather than
  hidden: transport encryption is the node operator's choice, and an app that
  silently refused to talk to an http node would look broken rather than secure.
  https is used whenever the user supplies it. What is never sent over any
  transport is a secret — the app holds no private key, so there is nothing here
  for a passive observer to take beyond public chain queries.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
