<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The minimum the app and the Edge Node need, and nothing more. -->
    <!-- Talk to an Obsidian node's RPC and to Obsidian peers. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Know whether to run or pause the Edge Node, rather than polling blindly. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The Edge Node runs only as a user-visible foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Required on Android 13+ for the foreground-service notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Deliberately NOT requested:
         RECEIVE_BOOT_COMPLETED — the Edge Node must never restart itself behind
           the user's back; it starts with the app and obeys the user's toggle.
         WAKE_LOCK — a phone is not a server. The Edge Node pauses when the OS
           suspends it instead of holding the CPU awake.
         Location, contacts, storage, camera — nothing here needs them. -->

    <application
        android:name=".ObsidianApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Obsidian"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Obsidian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Obsidian Edge Node: verify and relay only. It holds no wallet key,
             casts no vote, produces no block and earns nothing. -->
        <service
            android:name=".edgenode.EdgeNodeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
