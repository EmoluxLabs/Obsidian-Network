# Obsidian Core node as a systemd service.
#
#   sudo install -m 0644 deployment/systemd/obsidian-node.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now obsidian-node
[Unit]
Description=Obsidian Core node
Documentation=https://github.com/EmoluxLabs/Obsidian-Network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obsidian
Group=obsidian
WorkingDirectory=/opt/obsidian/core
EnvironmentFile=-/etc/obsidian/node.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/index.js start
Restart=always
RestartSec=5s

# The node holds keys in /var/lib/obsidian-node. It needs no other write access,
# no devices and no privileges of any kind.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/obsidian-node

[Install]
WantedBy=multi-user.target
