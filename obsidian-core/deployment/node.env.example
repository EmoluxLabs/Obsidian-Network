# /etc/obsidian/<network>/node.env — settings for ONE network's node.
#
# One file per network, never a shared one: /etc/obsidian/testnet/node.env,
# /etc/obsidian/devnet/node.env, … It is read by the template unit
# obsidian-node@<network>.service, where the text after the @ IS the network. The
# unit passes --network and --data-dir itself, so for the template you set neither
# OBSIDIAN_NETWORK nor OBSIDIAN_DATA_DIR here (and the node refuses to start if
# OBSIDIAN_NETWORK names a different network than the instance).
#
# If you run the plain obsidian-node.service instead (one network on the machine),
# it passes neither flag, so uncomment OBSIDIAN_NETWORK and OBSIDIAN_DATA_DIR below.
#
# Every variable the node reads is listed here. Copy the lines you need; the
# ones left commented out keep the default shown. Environment overrides the
# config file, and command-line flags override the environment, key by key.
#
#   defaults  <  --config file  <  OBSIDIAN_* environment  <  command-line flags
#
# Check what a running node actually resolved with (use the network's RPC port):
#   curl -s localhost:38630/status
#   node dist/index.js health --network devnet

# ── Identity ─────────────────────────────────────────────────────────────────
# Network: mainnet | testnet | staging | devnet. This is chain identity, not a
# preference: ports and the data directory follow it, and a node refuses a data
# directory written by a different network. If this, a config file and a
# --network flag disagree, the node refuses to start rather than pick one.
# Plain obsidian-node.service only; mainnet is a decision, not a default.
#OBSIDIAN_NETWORK=devnet
OBSIDIAN_NODE_NAME=node1

# Where this node keeps the chain, its indexer files and its identity key. The
# keystore defaults to <data dir>/node-key.json. Plain obsidian-node.service only.
#OBSIDIAN_DATA_DIR=/var/lib/obsidian-node
#OBSIDIAN_KEYSTORE_PATH=/var/lib/obsidian-node/node-key.json

# ── Keystore passphrase ──────────────────────────────────────────────────────
# Protect the node identity keystore (scrypt + AES-256-GCM). Prefer the file, readable
# by root and the service group and by nobody else (12 or more characters):
#   sudo install -m 0640 -o root -g obsidian /dev/null /etc/obsidian/<network>/keystore.pass
#   sudo sh -c 'printf %s "your-long-passphrase" > /etc/obsidian/<network>/keystore.pass'
# OBSIDIAN_KEYSTORE_PASSPHRASE (inline) takes precedence over the file. If
# neither is set, a TEST network (devnet/testnet/staging) generates one and
# writes it beside the keystore as node-key.json.pass with a warning. MAINNET
# REFUSES TO START that way: a passphrase kept beside the file it protects
# protects nothing, and this is the key that signs blocks.
OBSIDIAN_KEYSTORE_PASSPHRASE_FILE=/etc/obsidian/devnet/keystore.pass
#OBSIDIAN_KEYSTORE_PASSPHRASE=

# ── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error.  JSON logs suit a collector; set
# OBSIDIAN_LOG_JSON=false for human-readable lines.
OBSIDIAN_LOG_LEVEL=info
#OBSIDIAN_LOG_JSON=true

# ── RPC (the read/submit API; keep it on a private interface) ────────────────
#OBSIDIAN_RPC_ENABLED=true
OBSIDIAN_RPC_HOST=127.0.0.1
#OBSIDIAN_RPC_PORT=8630
# Pages on obsmainnet.us.ci and every subdomain of it (api., devnet., testnet.,
# staging., wallet., explorer., ...) may read this node from a browser by default,
# over HTTPS. Set false to answer only the origins listed below.
#OBSIDIAN_RPC_TRUST_OFFICIAL_DOMAINS=true
# More origins allowed to call RPC from a browser: exact origins, or a whole-subdomain
# pattern such as https://*.example.org (which does not include example.org itself).
# "*" must be deliberate; never pair it with a public RPC port.
#OBSIDIAN_RPC_CORS_ORIGINS=https://interface.example,https://*.example.org
# Per-IP requests per minute; 0 disables the limiter (private/dev only).
#OBSIDIAN_RPC_RATE_LIMIT_PER_MINUTE=240
# false makes the node read-only: it will not accept transactions.
#OBSIDIAN_RPC_ALLOW_SUBMIT=true
# The URL peers and interfaces should use to reach this node (for NAT/proxy).
#OBSIDIAN_RPC_PUBLIC_URL=https://node1.example
# Behind nginx/Cloudflare every connection arrives from the proxy, so without
# this ONE client's burst uses up the rate limit for everybody. true = rate-limit
# by the LAST X-Forwarded-For entry (the address your proxy appended; anything
# earlier is client-supplied). Only true behind a proxy you control.
#OBSIDIAN_RPC_TRUST_PROXY=false

# ── Peer-to-peer (public port; no CDN, no proxy) ─────────────────────────────
#OBSIDIAN_P2P_ENABLED=true
OBSIDIAN_P2P_HOST=0.0.0.0
#OBSIDIAN_P2P_PORT=8631
# The address peers should dial when this node is behind NAT. Empty = auto.
#OBSIDIAN_PUBLIC_HOST=node1.example

# ── Bootstrap peers ──────────────────────────────────────────────────────────
# `host:port` on a node's P2P port, comma separated — also settable with
# `--seeds`. (The short names OBSIDIAN_SEEDS, OBSIDIAN_KEYSTORE and
# OBSIDIAN_MINE are accepted as aliases of the three canonical names used here.) There is no shipped seed list: inventing host names would look
# authoritative while reaching nothing. A node with no peers still validates
# and serves reads; it just cannot learn about new blocks.
# (These are documentation addresses; use real peers' P2P ports on THIS network. Keep comments
# on their own lines: an environment file has no trailing comments, so text after a value
# becomes part of it.)
#OBSIDIAN_SEED_NODES=203.0.113.10:38631,203.0.113.11:38631

# ── Peer budgets ─────────────────────────────────────────────────────────────
#OBSIDIAN_MAX_PEERS=16
#OBSIDIAN_MAX_INBOUND_PEERS=64

# ── Mining ───────────────────────────────────────────────────────────────────
# A node that does not mine still validates everything and serves reads.
OBSIDIAN_MINING_ENABLED=true
# How often the producer checks whether its slot has come up. The protocol
# decides the slot itself; this only sets the polling interval.
#OBSIDIAN_BLOCK_INTERVAL_SECONDS=5
# (Obsidian pays no block reward, so there is no reward address to set; node
# operators are paid through the on-chain node registry. A data directory that
# belongs to another chain is always refused, and the explorer index is always
# built — OBSIDIAN_MINING_REWARD_ADDRESS, OBSIDIAN_INDEXER_ENABLED and
# OBSIDIAN_STRICT_DATA_DIR from older examples never did anything and now only
# log a warning.)

# ── Ports, all at once ───────────────────────────────────────────────────────
# Add this to the network defaults (mainnet 8630/8631, testnet 18630/18631,
# staging 28630/28631, devnet 38630/38631). Run several nodes on one host.
#OBSIDIAN_PORT_OFFSET=0

# ── Deliberate escape hatches ────────────────────────────────────────────────
# Refusing mainnet is the default in NODE_ENV=development. Setting this to true
# is an explicit decision to point a development process at real value.
#OBSIDIAN_ALLOW_MAINNET=false
# Print full stack traces instead of a one-line error.
#OBSIDIAN_DEBUG=
