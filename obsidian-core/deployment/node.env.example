# /etc/obsidian/node.env — configuration for a self-hosted Obsidian Core node.
#
# Network: mainnet | testnet | staging | devnet. Devnet data directories are
# disposable; mainnet ones are the wallet's history. Never point a node at a
# data directory that was written by a different network.
OBSIDIAN_NETWORK=mainnet
OBSIDIAN_NODE_NAME=node1

# Where this node keeps the chain and its identity key.
OBSIDIAN_DATA_DIR=/var/lib/obsidian-node
OBSIDIAN_KEYSTORE=/var/lib/obsidian-node/node-key.json

# The passphrase protects the node identity keystore (scrypt + AES-256-GCM).
# Put it in a root-owned file, not in shell history:
#   sudo install -m 0600 /dev/null /etc/obsidian/keystore.pass
#   sudo sh -c 'printf %s "your-long-passphrase" > /etc/obsidian/keystore.pass'
OBSIDIAN_KEYSTORE_PASSPHRASE_FILE=/etc/obsidian/keystore.pass

# Bootstrap peers. Any node that is already on the network will do; the node
# announces itself and discovers the rest.
OBSIDIAN_SEEDS=seed1.obsidian.example:8631,seed2.obsidian.example:8631

# Mining. A node that does not mine still validates everything and serves reads.
OBSIDIAN_MINE=true

OBSIDIAN_RPC_HOST=127.0.0.1
OBSIDIAN_P2P_HOST=0.0.0.0
OBSIDIAN_LOG_LEVEL=info
