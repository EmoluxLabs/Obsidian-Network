{
  "name": "@obsidian/core",
  "version": "1.6.0",
  "description": "Obsidian Core — standalone node software for the Obsidian Network blockchain (OBS).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "dist/index.js",
  "bin": {
    "obsidian-core": "dist/index.js"
  },
  "files": [
    "dist",
    "config",
    "deployment",
    "VERSION",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/index.js start",
    "start:devnet": "node dist/index.js start --config config/devnet.json",
    "start:testnet": "node dist/index.js start --config config/testnet.json",
    "start:staging": "node dist/index.js start --config config/staging.json",
    "start:mainnet": "node dist/index.js start --config config/mainnet.json",
    "node": "node dist/index.js node",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:all": "npm run test && npm run test:integration && npm run test:security",
    "genesis:init": "node dist/index.js genesis init",
    "node:keygen": "node dist/index.js keygen",
    "node:health": "node dist/index.js health",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@noble/curves": "1.6.0",
    "@noble/hashes": "1.5.0",
    "@scure/bip32": "1.5.0",
    "@scure/bip39": "1.4.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.18.13",
    "@types/ws": "8.5.12",
    "esbuild": "^0.25.12",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ws": "8.22.0"
  }
}
