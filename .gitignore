# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo
# generated browser bundles (rebuild with npm run build:web). The leading
# `**/` matters: a pattern containing a slash is anchored to this file's
# directory, so plain `public/js/` would only match a bundle at the repo root.
**/public/js/
# copied from obsidian-core/dist by scripts/sync-core.mjs
obsidian-interface/web/core/
obsidian-interface/dist/
obsidian-interface/.data/

# ── Node runtime state (never commit a chain or a keystore) ───────────────────
data/
*-data/
*.keystore.json
node-key.json
*.pass
peers.json
*.log
logs/
tmp/

# ── Secrets and local configuration ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── Release artefacts (generated by scripts/package-releases.sh) ──────────────
releases/*.zip
releases/*.tar.gz
releases/staging/

# ── Editor / OS noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
coverage/
.vitest/
